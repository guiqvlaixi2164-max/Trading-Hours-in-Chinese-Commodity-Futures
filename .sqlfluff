[sqlfluff]
dialect = duckdb
max_line_length = 100
# AM04: DuckDB's SELECT * EXCLUDE / REPLACE is used deliberately to carry columns through layers.
# ST06: keeping output columns in reading order matters more than wildcard-first ordering.
exclude_rules = AM04, ST06

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

# Natural column names for a date dimension and bar data, used unquoted by DuckDB and Power BI.
[sqlfluff:rules:references.keywords]
ignore_words = date, day, month, year, year_month, quarter, label, close, position
